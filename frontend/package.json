{
  "name": "rain-garden-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --ignore-path ../.prettierignore --write . ../README.md ../SECURITY.md ../docs ../docker-compose.yml",
    "format:check": "prettier --ignore-path ../.prettierignore --check . ../README.md ../SECURITY.md ../docs ../docker-compose.yml",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript openapi.json -o src/api/generated.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- openapi.json src/api/generated.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "leaflet": "1.9.4",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.2",
    "recharts": "3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
