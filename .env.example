# Copy to .env and replace every CHANGE_ME value before starting Docker.
POSTGRES_ADMIN_USER=rain_garden_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
APP_DB_NAME=rain_garden
APP_DB_USER=rain_garden_app
APP_DB_PASSWORD=CHANGE_ME_LOCAL_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://rain_garden_app:CHANGE_ME_LOCAL_APP_PASSWORD@db:5432/rain_garden

APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBHOOK_BODY_LIMIT_BYTES=262144
TTN_WEBHOOK_ENABLED=false
TTN_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
TTN_MQTT_HOST=eu1.cloud.thethings.network
TTN_MQTT_PORT=8883
TTN_MQTT_USERNAME=your-ttn-username
TTN_MQTT_TOPIC=v3/your-ttn-username/devices/+/up
TTN_MQTT_API_KEY=your-ttn-api-key
PUBLIC_RATE_LIMIT_REQUESTS=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
INGESTION_RATE_LIMIT_REQUESTS=30
INGESTION_RATE_LIMIT_WINDOW_SECONDS=60
DEVICE_STALE_AFTER_MINUTES=90
DEVICE_OFFLINE_AFTER_MINUTES=180
MAX_MEASUREMENT_RANGE_DAYS=31
DEFAULT_MEASUREMENT_RANGE_DAYS=7
MAX_MEASUREMENT_RESULT_ROWS=5000
CHART_MEASUREMENT_TARGET_POINTS=2000
